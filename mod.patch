         None,
     );
     assert!(super::provider_is_opencode_go(&trailing_slash));
+
+    // The US-forwarding proxy path keeps the failover armed (option B wiring).
+    let via_loopback_proxy = create_model_provider(
+        ModelProviderInfo {
+            name: "OpenCode Go".into(),
+            base_url: Some("http://127.0.0.1:18887/v1".into()),
+            ..Default::default()
+        },
+        None,
+    );
+    assert!(super::provider_is_opencode_go(&via_loopback_proxy));
+
+    let loopback_with_wrong_name = create_model_provider(
