     // `Some(Cached/Live/Disabled)` are the options for mode when standalone search is unavailable
     // and the provider supports hosted search. `None` prevents emitting a hosted search tool.
+    // Respect the per-model `supports_search_tool` flag in addition to the
+    // provider capability. Custom providers can expose models whose upstream
+    // rejects the hosted `web_search` tool (verified on the opencode-go gateway
+    // for kimi/glm/mimo/hy3), so the model catalog flag must gate emission.
     let web_search_mode = (!standalone_web_search_available
