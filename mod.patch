Subject: [PATCH 6/9] codex-swapper mod: keep OpenCode Go key failover armed
 when provider is routed via the US-forwarding loopback proxy

---
 codex-rs/core/src/client.rs       | 10 +++++++++-
 codex-rs/core/src/client_tests.rs | 21 +++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/codex-rs/core/src/client.rs b/codex-rs/core/src/client.rs
index 1795c96fc..0e426ad7c 100644
--- a/codex-rs/core/src/client.rs
+++ b/codex-rs/core/src/client.rs
@@ -203,7 +203,15 @@ fn provider_is_opencode_go(provider: &SharedModelProvider) -> bool {
         .info()
         .base_url
         .as_deref()
-        .is_some_and(|url| url.trim_end_matches('/') == "https://opencode.ai/zen/go/v1")
+        .is_some_and(|url| {
+            let url = url.trim_end_matches('/');
+            url == "https://opencode.ai/zen/go/v1"
+                // The US-forwarding proxy (us-forward-proxy.py) redirects the
+                // provider to a loopback URL; keep the failover armed there.
+                || (provider.info().name == "OpenCode Go"
+                    && (url.starts_with("http://127.0.0.1:") || url.starts_with("http://localhost:"))
+                    && url.ends_with("/v1"))
+        })
 }
 
 /// Rotates the preferred OpenCode Go key between `1` and `2` in `home`.
