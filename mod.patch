+/// Returns `true` when the resolved provider is the OpenCode Go gateway.
+///
+/// The gateway is identified by its base URL so the failover applies only to
+/// this provider and never touches the OpenAI or other provider paths.
+fn provider_is_opencode_go(provider: &SharedModelProvider) -> bool {
+    provider
+        .info()
+        .base_url
+        .as_deref()
+        .is_some_and(|url| url.trim_end_matches('/') == "https://opencode.ai/zen/go/v1")
+}
+
+/// Rotates the preferred OpenCode Go key between `1` and `2` in `home`.
+///
+/// The active key lives in `<home>/oc-go.key` (default `1`) so the harness and
+/// the auth dispatcher script (`~/.codex/bin/oc-go-key`) stay in agreement.
+/// When `<home>/oc-go.override` exists the key is user-pinned and rotation is
+/// skipped (the pinned key always wins on the dispatcher side).
+fn rotate_opencode_go_key_state(home: &std::path::Path) -> std::io::Result<()> {
+    if home.join("oc-go.override").is_file() {
+        return Ok(());
+    }
+    let key_path = home.join("oc-go.key");
+    let current = std::fs::read_to_string(&key_path)
+        .ok()
+        .and_then(|contents| contents.trim().parse::<u8>().ok())
+        .unwrap_or(1);
+    let next = if current == 1 { 2 } else { 1 };
+    std::fs::write(&key_path, format!("{next}\n"))?;
+    Ok(())
+}
+
+fn flip_opencode_go_key() -> std::io::Result<()> {
+    rotate_opencode_go_key_state(&codex_utils_home_dir::find_codex_home()?)
+}
