+        std::fs::read_to_string(temp.path().join("oc-go.key"))?.trim(),
+        "1"
+    );
+    Ok(())
+}
+
+#[test]
+fn rotate_opencode_go_key_state_respects_override() -> anyhow::Result<()> {
+    let temp = TempDir::new()?;
+    std::fs::write(temp.path().join("oc-go.override"), "2\n")?;
+    std::fs::write(temp.path().join("oc-go.key"), "1\n")?;
+    super::rotate_opencode_go_key_state(temp.path())?;
+    assert_eq!(
+        std::fs::read_to_string(temp.path().join("oc-go.key"))?.trim(),
+        "1"
+    );
+    Ok(())
+}
+
+#[test]
+fn provider_is_opencode_go_matches_only_gateway_url() {
+    let opencode = create_model_provider(
+        ModelProviderInfo {
+            name: "OpenCode Go".into(),
+            base_url: Some("https://opencode.ai/zen/go/v1".into()),
+            ..Default::default()
+        },
+        None,
+    );
+    assert!(super::provider_is_opencode_go(&opencode));
+
+    let openai = create_model_provider(
+        ModelProviderInfo {
+            name: "OpenAI".into(),
+            base_url: None,
+            ..Default::default()
+        },
+        None,
+    );
+    assert!(!super::provider_is_opencode_go(&openai));
+
+    let trailing_slash = create_model_provider(
+        ModelProviderInfo {
+            name: "OpenCode Go".into(),
+            base_url: Some("https://opencode.ai/zen/go/v1/".into()),
+            ..Default::default()
+        },
+        None,
+    );
+    assert!(super::provider_is_opencode_go(&trailing_slash));
+}
