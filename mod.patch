+            name: "Some Other Gateway".into(),
+            base_url: Some("http://127.0.0.1:18887/v1".into()),
+            ..Default::default()
+        },
+        None,
+    );
+    assert!(!super::provider_is_opencode_go(&loopback_with_wrong_name));
 }
 
 #[tokio::test]
