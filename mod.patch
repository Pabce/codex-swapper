+/// Path used for convention-based per-provider static catalogs:
+/// `<codex_home>/model-catalogs/<provider-id>.json`.
+fn provider_catalog_path(codex_home: &std::path::Path, provider_id: &str) -> std::path::PathBuf {
+    codex_home.join("model-catalogs").join(format!("{provider_id}.json"))
+}
+
+/// Load a convention-based static catalog for a registered custom provider.
+///
+/// Returns `None` when the file is missing or does not parse as a model
+/// catalog, so unrelated built-in providers are silently skipped.
+fn load_provider_catalog(
+    codex_home: &std::path::Path,
+    provider_id: &str,
+) -> Option<ModelsResponse> {
+    let path = provider_catalog_path(codex_home, provider_id);
+    let contents = std::fs::read_to_string(path).ok()?;
+    serde_json::from_str::<ModelsResponse>(&contents).ok()
+}
+
+/// Return the id of a registered non-active custom provider whose
+/// convention-based static catalog contains `model`.
+pub(crate) fn resolve_model_provider(config: &Config, model: &str) -> Option<String> {
+    resolve_model_provider_in_catalogs(
+        &config.model_providers,
+        &config.model_provider_id,
+        config.codex_home.as_path(),
+        model,
+    )
+}
+
+fn resolve_model_provider_in_catalogs(
+    model_providers: &HashMap<String, ModelProviderInfo>,
+    active_provider_id: &str,
+    codex_home: &std::path::Path,
+    model: &str,
+) -> Option<String> {
+    for provider_id in model_providers.keys() {
+        if provider_id == active_provider_id || provider_id == "openai" {
+            continue;
+        }
+        if let Some(catalog) = load_provider_catalog(codex_home, provider_id.as_str()) {
+            if catalog.models.iter().any(|info| info.slug == model) {
+                return Some(provider_id.clone());
+            }
+        }
+    }
+    None
+}
+
+/// Merge the active provider's models with the convention-based static
+/// catalogs of any registered custom providers.
+pub async fn merged_supported_models(
+    config: &Config,
+    thread_manager: Arc<ThreadManager>,
+    include_hidden: bool,
+    http_client_factory: HttpClientFactory,
+) -> Vec<Model> {
+    let mut models = supported_models(thread_manager, include_hidden, http_client_factory).await;
+
+    for provider_id in config.model_providers.keys() {
+        if provider_id == &config.model_provider_id || provider_id == "openai" {
+            continue;
+        }
+        let Some(catalog) =
+            load_provider_catalog(config.codex_home.as_path(), provider_id.as_str())
+        else {
+            continue;
+        };
+        for info in catalog.models {
+            let preset = ModelPreset::from(info);
+            if include_hidden || preset.show_in_picker {
+                models.push(model_from_preset(preset));
+            }
+        }
+    }
+
+    models
+}
