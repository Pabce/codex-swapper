+
+/// Custom providers configured with a convention-based static catalog
+/// (`<codex_home>/model-catalogs/<provider-id>.json`) would otherwise be
+/// treated as remote-catalog providers, which fails against backends that do
+/// not speak the Codex model-catalog schema. Inject the catalog path into the
+/// per-thread request overrides when the resolved provider has one on disk.
+fn maybe_inject_provider_catalog(
+    codex_home: &Path,
+    model_provider: Option<&str>,
+    request_overrides: &mut HashMap<String, serde_json::Value>,
+) {
+    let Some(provider_id) = model_provider else {
+        return;
+    };
+    if provider_id == "openai" {
+        return;
+    }
+    let catalog_path = codex_home
+        .join("model-catalogs")
+        .join(format!("{provider_id}.json"));
+    if catalog_path.exists() {
+        request_overrides
+            .entry("model_catalog_json".to_string())
+            .or_insert_with(|| serde_json::json!(catalog_path.display().to_string()));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use tempfile::tempdir;
+
+    #[test]
+    fn injects_catalog_for_custom_provider_with_convention_file() {
+        let dir = tempdir().unwrap();
+        let models_dir = dir.path().join("model-catalogs");
+        fs::create_dir_all(&models_dir).unwrap();
+        fs::write(models_dir.join("opencode-go.json"), "{}").unwrap();
+
+        let mut overrides = HashMap::new();
+        maybe_inject_provider_catalog(dir.path(), Some("opencode-go"), &mut overrides);
+
+        assert_eq!(
+            overrides.get("model_catalog_json"),
+            Some(&serde_json::json!(
+                models_dir.join("opencode-go.json").display().to_string()
+            ))
+        );
+    }
+
+    #[test]
+    fn skips_openai_and_missing_catalog_and_none() {
+        let dir = tempdir().unwrap();
+
+        let mut overrides = HashMap::new();
+        maybe_inject_provider_catalog(dir.path(), Some("openai"), &mut overrides);
+        assert!(overrides.is_empty());
+
+        maybe_inject_provider_catalog(dir.path(), Some("opencode-go"), &mut overrides);
+        assert!(overrides.is_empty());
+
+        maybe_inject_provider_catalog(dir.path(), None, &mut overrides);
+        assert!(overrides.is_empty());
+    }
+}
