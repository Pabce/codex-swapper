+#[tokio::test]
+async fn custom_provider_responses_request_omits_client_metadata() -> anyhow::Result<()> {
+    // client_metadata is OpenAI-internal turn telemetry. Custom providers such
+    // as the opencode-go gateway reject it (verified live with grok-4.5:
+    // "json: unknown field client_metadata"), so it must be omitted for any
+    // non-OpenAI provider while remaining present for the OpenAI provider.
+    let client = test_model_client(SessionSource::Cli);
+    let prompt = Prompt {
+        input: vec![ResponseItem::Message {
+            id: None,
+            role: "user".to_string(),
+            content: vec![ContentItem::InputText {
+                text: "hello".to_string(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }],
+        base_instructions: BaseInstructions {
+            text: "base instructions".to_string(),
+            provenance: None,
+        },
+        ..Default::default()
+    };
+    let responses_metadata = test_responses_metadata_for_client(
+        &client,
+        /*turn_id*/ None,
+        format!("{}:0", client.state.thread_id),
+        /*parent_thread_id*/ None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let request = client.build_responses_request(
+        &prompt,
+        &test_model_info(),
+        /*effort*/ None,
+        codex_protocol::config_types::ReasoningSummary::None,
+        /*service_tier*/ None,
+        &responses_metadata,
+    )?;
+    assert!(
+        request.client_metadata.is_none(),
+        "custom provider must not receive OpenAI client_metadata"
+    );
+    Ok(())
+}
